{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k17",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "K17_DB" }
  ]
}
